      "id": "5ffc91f6-ead4-4c3d-8b64-f904530d3810",
      "name": "Get Forums",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        192
      ],
      "executeOnce": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Set Config').first().json;\nconst raw = $input.all();\nconst allForums = [];\nfor (const item of raw) {\n  if (Array.isArray(item.json)) allForums.push(...item.json);\n  else if (item.json && typeof item.json === 'object') allForums.push(item.json);\n}\nconst targetCmids = Array.isArray(cfg.targetCmids) ? cfg.targetCmids : [];\nconst targetSet = new Set(targetCmids.map(Number));\nconst forums = targetCmids.length === 0 ? allForums : allForums.filter(f => targetSet.has(Number(f.cmid)));\nreturn forums.map((f, i) => ({ json: { forumId: f.id, forumName: f.name, cmid: f.cmid }, pairedItem: { item: i } }));\n"
      },
      "id": "3b9328dd-9ea1-41e9-9967-6a274e6f1a2e",
      "name": "Filter Target Forums",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        128
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Set Config').first().json.moodleHost + '/webservice/rest/server.php' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "wstoken",
              "value": "={{ $('Get Token').first().json.token }}"
            },
            {
              "name": "wsfunction",
              "value": "mod_forum_get_forum_discussions"
            },
            {
              "name": "forumid",
              "value": "={{ $json.forumId }}"
            },
            {
              "name": "perpage",
              "value": "={{ $('Set Config').first().json.perPage }}"
            },
