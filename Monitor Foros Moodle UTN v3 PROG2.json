    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nconst cfg = $('Set Config').first().json;\nconst limit = Number(cfg.dedupeLimit) || 1000;\nconst existing = new Set(staticData.notifiedDiscussionIds || []);\nconst items = $input.all();\nconst marked = [];\nfor (let i = 0; i < items.length; i++) {\n  const ctx = $('Filter Already Notified').itemMatching(i) ?? $('Find Unanswered').itemMatching(i);\n  const id = ctx?.json?.discussionId;\n  if (id !== undefined) { existing.add(id); marked.push(id); }\n}\nlet arr = Array.from(existing);\nif (arr.length > limit) arr = arr.slice(-limit);\nstaticData.notifiedDiscussionIds = arr;\nstaticData.lastSuccessfulRun = new Date().toISOString();\nstaticData.lastNotifiedCount = marked.length;\nreturn marked.map(id => ({ json: { discussionId: id, status: 'notified' } }));\n"
      },
      "id": "f6c08fcb-567d-4004-9984-60b38b0bc469",
      "name": "Mark as Notified",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst cfg = $('Set Config').first().json;\nconst now = new Date().toISOString().slice(0, 16).replace('T', ' ');\nlet errorMsg = 'Error desconocido';\nfor (const item of items) {\n  const candidate = item?.json?.error?.message || item?.error?.message || (typeof item?.json?.error === 'string' ? item.json.error : null) || item?.json?.message;\n  if (candidate) { errorMsg = String(candidate); break; }\n}\nlet ctxLine = '';\nif (items[0]?.json?.discussionId !== undefined) ctxLine = '\\n📌 Discusion: ' + items[0].json.discussionId;\nconst text = '❌ <b>Monitor Foros — Falla</b>\\n🕐 ' + now + ctxLine + '\\n\\n<code>' + errorMsg.slice(0, 300) + '</code>';\nreturn [{ json: { chatId: cfg.errorChatId, text } }];\n"
      },
