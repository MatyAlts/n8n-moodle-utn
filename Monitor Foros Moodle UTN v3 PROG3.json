      "id": "b1cf5c25-aa99-4bed-94d9-a550c151bfd1",
      "name": "Get Discussions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        192
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nfunction stripHtml(html) { return (html||'').replace(/<[^>]*>/g,'').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/\\s+/g,' ').trim(); }\nconst cfg = $('Set Config').first().json;\nconst items = $input.all();\nconst unanswered = [];\nfor (let i = 0; i < items.length; i++) {\n  const data = items[i].json || {};\n  const forumCtx = $('Filter Target Forums').itemMatching(i);\n  const forumId = forumCtx?.json?.forumId;\n  const forumName = forumCtx?.json?.forumName || 'Foro desconocido';\n  const discussions = Array.isArray(data.discussions) ? data.discussions : Array.isArray(data) ? data : [];\n  for (const d of discussions) {\n    if (d.numreplies === 0) {\n      let body = stripHtml(d.message || '');\n      if (body.length > 300) body = body.substring(0, 300) + '...';\n      unanswered.push({ json: { discussionId: d.discussion, forumId, forumName, title: d.subject || d.name, author: d.userfullname || 'Desconocido', body, createdAt: d.created, url: 'https://tup.sied.utn.edu.ar/mod/forum/discuss.php?d=' + d.discussion, cbGenerate: 'generate:' + d.discussion + ':' + cfg.namespace }, pairedItem: { item: i } });\n    }\n  }\n}\nreturn unanswered;\n"
      },
      "id": "b8834de8-7650-4393-af0a-963288d53fcc",
      "name": "Find Unanswered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nconst FIRST_RUN_KEY = 'monitorInitialized';\nconst isFirstRun = !staticData[FIRST_RUN_KEY];\nconst notifiedIds = new Set(staticData.notifiedDiscussionIds || []);\nconst items = $input.all();\nif (isFirstRun) {\n  for (const item of items) notifiedIds.add(item.json.discussionId);\n  staticData.notifiedDiscussionIds = Array.from(notifiedIds);\n  staticData[FIRST_RUN_KEY] = true;\n  staticData.coldStartAt = new Date().toISOString();\n  staticData.coldStartCount = items.length;\n  return [];\n}\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  if (!notifiedIds.has(item.json.discussionId)) out.push({ json: item.json, pairedItem: item.pairedItem ?? { item: i } });\n}\nreturn out;\n"
      },
