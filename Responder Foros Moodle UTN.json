    {
      "parameters": {
        "jsCode": "const posts = $json.posts || [];\nconst firstPost = posts[0] || {};\n\nfunction stripHtml(html) {\n  return (html || '').replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/\\s+/g, ' ').trim();\n}\n\nconst question = stripHtml(firstPost.message || '');\nconst postId = firstPost.id;\nconst discussionId = $('Parse Event').first().json.discussionId;\nconst chatId = $('Parse Event').first().json.chatId;\nconst subject = firstPost.subject || 'Re:';\n\nreturn [{ json: { question, postId, discussionId, chatId, subject } }];"
      },
