    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.pendingResponses) staticData.pendingResponses = {};\nconst response = $json.response || '';\nconst discussionId = $('Prepare Question').first().json.discussionId;\nconst postId = $('Prepare Question').first().json.postId;\nconst subject = $('Prepare Question').first().json.subject;\nconst chatId = $('Prepare Question').first().json.chatId;\nfunction escapeHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction formatInline(text) { text = escapeHtml(text); return text.replace(/\\*\\*(.+?)\\*\\*/g,'<b>$1</b>').replace(/\\*(.+?)\\*/g,'<i>$1</i>').replace(/__(.+?)__/g,'<b>$1</b>').replace(/_(.+?)_/g,'<i>$1</i>').replace(/`([^`]+)`/g,'<code>$1</code>'); }\nfunction formatInlineTelegram(text) { text = escapeHtml(text); return text.replace(/\\*\\*(.+?)\\*\\*/g,'<b>$1</b>').replace(/__(.+?)__/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code>$1</code>'); }\nconst BT3 = String.fromCharCode(96).repeat(3);\nconst fencePattern = new RegExp(BT3 + '(\\\\w*)\\\\n?([\\\\s\\\\S]*?)' + BT3, 'g');\nconst fencePatternTg = new RegExp(BT3 + '\\\\w*\\\\n?[\\\\s\\\\S]*?' + BT3, 'g');\nfunction markdownToHtml(text) {\n  const codeBlocks = [];\n  const withPlaceholders = text.replace(fencePattern, (match, lang, code) => { const escaped = escapeHtml(code.replace(/\\n$/, '')); const idx = codeBlocks.length; codeBlocks.push('<pre><code>' + escaped + '</code></pre>'); return '\\n%%CB_' + idx + '%%\\n'; });\n  const lines = withPlaceholders.split('\\n');\n  const result = [];\n  let inOl = false, inUl = false;\n  for (const line of lines) {\n    const trimmed = line.trim();\n    const cbMatch = trimmed.match(/^%%CB_(\\d+)%%$/);\n    if (cbMatch) { if (inOl) { result.push('</ol>'); inOl = false; } if (inUl) { result.push('</ul>'); inUl = false; } result.push(codeBlocks[parseInt(cbMatch[1])]); continue; }\n    const olMatch = trimmed.match(/^\\d+\\.\\s+(.*)/);\n    const ulMatch = trimmed.match(/^[-*]\\s+(.*)/);\n    const headingMatch = trimmed.match(/^#{1,3}\\s+(.*)/);\n    if (headingMatch) { if (inOl) { result.push('</ol>'); inOl = false; } if (inUl) { result.push('</ul>'); inUl = false; } result.push('<b>' + formatInline(headingMatch[1]) + '</b>'); }\n    else if (olMatch) { if (inUl) { result.push('</ul>'); inUl = false; } if (!inOl) { result.push('<ol>'); inOl = true; } result.push('<li>' + formatInline(olMatch[1]) + '</li>'); }\n    else if (ulMatch) { if (inOl) { result.push('</ol>'); inOl = false; } if (!inUl) { result.push('<ul>'); inUl = true; } result.push('<li>' + formatInline(ulMatch[1]) + '</li>'); }\n    else { if (inOl) { result.push('</ol>'); inOl = false; } if (inUl) { result.push('</ul>'); inUl = false; } if (trimmed === '') result.push('<br>'); else result.push('<p>' + formatInline(trimmed) + '</p>'); }\n  }\n  if (inOl) result.push('</ol>');\n  if (inUl) result.push('</ul>');\n  return result.join('\\n');\n}\nfunction toTelegramPreview(text) { return formatInlineTelegram(text.replace(fencePatternTg, '<i>[ver código en Moodle]</i>')); }\nconst htmlResponse = markdownToHtml(response);\nstaticData.pendingResponses[String(discussionId)] = { text: htmlResponse, postId, subject };\nconst telegramPreview = toTelegramPreview(response);\nconst preview = '\\u{1F4DD} <b>Respuesta generada por IA:</b>\\n\\n' + telegramPreview + '\\n\\n<i>\\u00BFQu\\u00E9 hacemos con esta respuesta?</i>';\nreturn [{ json: { preview, discussionId, chatId, cbPublish: 'publish:' + discussionId, cbEdit: 'edit:' + discussionId, cbDiscard: 'discard:' + discussionId } }];\n"
      },
