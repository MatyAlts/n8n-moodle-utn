    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.pendingResponses) staticData.pendingResponses = {};\n\nconst response = $json.response || '';\nconst discussionId = $('Prepare Question').first().json.discussionId;\nconst postId = $('Prepare Question').first().json.postId;\nconst subject = $('Prepare Question').first().json.subject;\nconst chatId = $('Prepare Question').first().json.chatId;\n\nfunction formatInline(text) {\n  return text\n    .replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>')\n    .replace(/__(.+?)__/g, '<b>$1</b>')\n    .replace(/`([^`]+)`/g, '<code>$1</code>');\n}\n\nfunction markdownToHtml(text) {\n  const lines = text.split('\\n');\n  const result = [];\n  let inOl = false;\n  let inUl = false;\n\n  for (const line of lines) {\n    const olMatch = line.match(/^\\d+\\.\\s+(.*)/);\n    const ulMatch = line.match(/^[-*]\\s+(.*)/);\n\n    if (olMatch) {\n      if (inUl) { result.push('</ul>'); inUl = false; }\n      if (!inOl) { result.push('<ol>'); inOl = true; }\n      result.push('<li>' + formatInline(olMatch[1]) + '</li>');\n    } else if (ulMatch) {\n      if (inOl) { result.push('</ol>'); inOl = false; }\n      if (!inUl) { result.push('<ul>'); inUl = true; }\n      result.push('<li>' + formatInline(ulMatch[1]) + '</li>');\n    } else {\n      if (inOl) { result.push('</ol>'); inOl = false; }\n      if (inUl) { result.push('</ul>'); inUl = false; }\n      if (line.trim() === '') {\n        result.push('<br>');\n      } else {\n        result.push('<p>' + formatInline(line) + '</p>');\n      }\n    }\n  }\n\n  if (inOl) result.push('</ol>');\n  if (inUl) result.push('</ul>');\n\n  return result.join('\\n');\n}\n\nconst htmlResponse = markdownToHtml(response);\nstaticData.pendingResponses[String(discussionId)] = { text: htmlResponse, postId, subject };\n\nconst telegramPreview = formatInline(response);\nconst preview = '\\u{1F4DD} <b>Respuesta generada por IA:</b>\\n\\n' + telegramPreview + '\\n\\n<i>\\u00BFQu\\u00E9 hacemos con esta respuesta?</i>';\n\nreturn [{ json: {\n  preview,\n  discussionId,\n  chatId,\n  cbPublish: 'publish:' + discussionId,\n  cbEdit: 'edit:' + discussionId,\n  cbDiscard: 'discard:' + discussionId\n} }];"
      },
