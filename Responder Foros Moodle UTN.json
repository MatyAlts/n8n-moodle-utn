      "parameters": {
        "jsCode": "\nconst PENDING_EDIT_TTL_MS = 30 * 60 * 1000;\nfunction escapeHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nconst item = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (item.callback_query) {\n  const parts = (item.callback_query.data || '').split(':');\n  const action = parts[0];\n  const discussionId = parseInt(parts[1]);\n  const namespace = parts[2] || 'prog1';\n  return [{ json: { action, discussionId, namespace, callbackQueryId: item.callback_query.id, chatId: String(item.callback_query.message?.chat?.id || '1415649706') } }];\n}\nif (item.message?.text) {\n  const pending = staticData.pendingEdit;\n  if (pending) {\n    const age = pending.createdAt ? (Date.now() - pending.createdAt) : Infinity;\n    if (age < PENDING_EDIT_TTL_MS) {\n      const text = item.message.text;\n      return [{ json: { action: 'text_reply', discussionId: pending.discussionId, postId: pending.postId, text, textHtml: '<p>' + escapeHtml(text) + '</p>', chatId: String(item.message.chat?.id || '1415649706') } }];\n    }\n    delete staticData.pendingEdit;\n  }\n}\nreturn [{ json: { action: 'ignore' } }];\n"
      },
