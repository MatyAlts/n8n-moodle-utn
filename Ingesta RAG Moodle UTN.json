      "id": "8d817358-3e22-4f6f-b98a-5a407aa60fe9",
      "name": "Seleccionar Materia",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        208
      ],
      "webhookId": "5a5f2224-cec8-4925-9995-9fae71460978"
    },
    {
      "parameters": {
        "jsCode": "const materia = $input.first().json.materia;\n\nconst config = {\n  prog1: { folderId: '1d4yiQzrvgRDZPUc9aNg7S3PzP0cB-JaT', label: 'Programación 1' },\n  prog2: { folderId: '1Hot5A5uxBXvUnuNPWtOyVeFe3HbTXeLH', label: 'Programación 2' },\n  prog3: { folderId: '1Liqve8pM_vhXMN-rGc_vcEZ9lAq_XyQB', label: 'Programación 3' },\n};\n\nconst cfg = config[materia];\nif (!cfg) throw new Error('Materia inválida: ' + materia);\n\nreturn [{ json: {\n  materia,\n  namespace: materia,\n  rootFolderId: cfg.folderId,\n  materiaLabel: cfg.label,\n  errorChatId: '1415649706',\n} }];"
      },
      "id": "9b9d79bc-809f-425a-9877-fdee57f2d6db",
      "name": "Configure Root Folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "unidad",
        "returnAll": true,
        "filter": {
          "driveId": {
            "__rl": true,
            "mode": "list",
            "value": "My Drive"
          },
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.rootFolderId }}"
          },
          "whatToSearch": "folders"
        },
        "options": {
          "fields": [
            "id",
            "name"
          ]
        }
      },
      "id": "d52da5e1-469d-4f84-b5b9-d287c9a19cf5",
      "name": "List Unit Folders",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        448,
        208
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "jCCRX6ZTZtLkhVwG",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst config = $('Configure Root Folder').first().json;\nconst materia = config.materia;\nconst namespace = config.namespace;\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const folder = items[i].json;\n  const folderName = String(folder.name || '');\n  const m = folderName.match(/unidad\\s*(\\d+)/i);\n  out.push({\n    json: {\n      folderId: folder.id,\n      folderName,\n      unidad: m ? m[1] : 'unknown',\n      unidadNombre: folderName,\n      materia,\n      namespace,\n    },\n    pairedItem: { item: i },\n  });\n}\nreturn out;"
      },
      "id": "75eaa127-028a-4db9-bc1d-bc949af36e0e",
      "name": "Prepare Unit Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        208
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "driveId": {
            "__rl": true,
            "mode": "list",
            "value": "My Drive"
          },
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.folderId }}"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType",
            "modifiedTime",
            "webViewLink"
          ]
        }
      },
      "id": "0fd0fa9d-c278-41e5-8dc7-8cec7b469313",
      "name": "List PDFs in Unit",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        896,
        208
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "jCCRX6ZTZtLkhVwG",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const pdf = items[i].json;\n  if (pdf.mimeType !== 'application/pdf') continue;\n  const unitCtx = $('Prepare Unit Context').itemMatching(i);\n  const unidad = unitCtx?.json?.unidad ?? 'unknown';\n  const unidadNombre = unitCtx?.json?.unidadNombre ?? '?';\n  const materia = unitCtx?.json?.materia ?? '';\n  const namespace = unitCtx?.json?.namespace ?? '';\n  out.push({\n    json: {\n      fileId: pdf.id,\n      fileName: pdf.name,\n      mimeType: pdf.mimeType,\n      modifiedTime: pdf.modifiedTime || '',\n      fileUrl: pdf.webViewLink || ('https://drive.google.com/file/d/' + pdf.id + '/view'),\n      unidad,\n      unidadNombre,\n      materia,\n      namespace,\n    },\n    pairedItem: items[i].pairedItem ?? { item: i },\n  });\n}\nreturn out;"
      },
      "id": "aff5bad7-bba3-458a-88f5-16ff658f5104",
      "name": "Prepare PDF Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst materia = $input.first().json.materia;\n\nif (!staticData.processedFileIds) staticData.processedFileIds = {};\nconst processedIds = new Set(staticData.processedFileIds[materia] || []);\n\nconst items = $input.all();\nconst out = [];\nconst newIds = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const id = item.json.fileId;\n  if (processedIds.has(id)) continue;\n  newIds.push(id);\n  out.push({\n    json: item.json,\n    pairedItem: item.pairedItem ?? { item: i },\n  });\n}\n\nif (newIds.length > 0) {\n  staticData.processedFileIds[materia] = [...processedIds, ...newIds];\n}\n\nreturn out;"
      },
      "id": "e55f72d9-220a-4051-8bc4-016418146f36",
      "name": "Filter Already Ingested",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        208
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
