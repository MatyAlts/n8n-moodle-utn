      "id": "a6a825cb-4c38-4396-935f-d84f334d1290",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1792,
        208
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const ctx = $('Filter Already Ingested').itemMatching(i);\n  if (!ctx) continue;\n  out.push({\n    json: {\n      ...ctx.json,\n      text: item.json.text || '',\n    },\n    pairedItem: item.pairedItem ?? { item: i },\n  });\n}\nreturn out;"
      },
      "id": "985d82e4-7e90-4c16-8bb9-6b4ce9fcd626",
      "name": "Restore Context",
      "type": "n8n-nodes-base.code",
