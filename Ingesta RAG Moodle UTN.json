    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const errorMsg = item.json?.error?.message\n               || item.error?.message\n               || (typeof item.json?.error === 'string' ? item.json.error : null)\n               || 'Error desconocido';\n  out.push({\n    json: {\n      chatId: '1415649706',\n      text: '\\u274C <b>Falla en ingesta RAG</b>\\n\\u26A0\\uFE0F <code>' + String(errorMsg).slice(0, 300) + '</code>',\n    },\n  });\n}\nreturn out;"
      },
