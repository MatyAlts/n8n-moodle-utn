    {
      "parameters": {
        "jsCode": "const TARGET_CMIDS = [11156, 11201, 11226, 11181, 11248];\nconst items = $input.all();\nconst filtered = items.filter(item => TARGET_CMIDS.includes(item.json.cmid));\nreturn filtered.map(item => ({\n  json: { forumId: item.json.id, forumName: item.json.name, cmid: item.json.cmid }\n}));"
      },
      "id": "4b1f7619-bc93-4bc8-8e64-05431144d271",
      "name": "Filtrar Foros Objetivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://tup.sied.utn.edu.ar/webservice/rest/server.php",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "wstoken",
              "value": "={{ $(\"Obtener Token\").first().json.token }}"
            },
            {
              "name": "wsfunction",
              "value": "mod_forum_get_forum_discussions"
            },
            {
              "name": "forumid",
              "value": "={{ $json.forumId }}"
