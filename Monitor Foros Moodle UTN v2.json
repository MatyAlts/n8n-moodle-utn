      "id": "17f10b64-24a5-4ddd-a9fd-ba00215d4682",
      "name": "Obtener Discusiones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1040,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst forums = $('Filtrar Foros Objetivo').all();\nconst unanswered = [];\n\nfunction stripHtml(html) {\n  return html.replace(/<[^>]*>/g, \"\").replace(/&nbsp;/g, \" \").replace(/&amp;/g, \"&\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, '\"').replace(/\\s+/g, \" \").trim();\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const forumName = forums[i] ? forums[i].json.forumName : 'Foro desconocido';\n  const discussions = items[i].json.discussions || [];\n  for (const d of discussions) {\n    if (d.numreplies === 0) {\n      let body = stripHtml(d.message || \"\");\n      if (body.length > 300) body = body.substring(0, 300) + \"...\";\n      unanswered.push({ json: {\n        discussionId: d.discussion,\n        forumName,\n        title: d.subject || d.name,\n        author: d.userfullname || 'Desconocido',\n        body,\n        url: 'https://tup.sied.utn.edu.ar/mod/forum/discuss.php?d=' + d.discussion\n      }});\n    }\n  }\n}\nreturn unanswered;"
      },
      "id": "37fa23b0-825a-4203-96a1-df7ab2c064bd",
      "name": "Buscar Consultas Sin Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.notifiedDiscussionIds = [];\nconst notifiedIds = new Set(staticData.notifiedDiscussionIds || []);\n\nconst items = $input.all();\nconst newItems = items.filter(item => !notifiedIds.has(item.json.discussionId));\n\nnewItems.forEach(item => notifiedIds.add(item.json.discussionId));\nstaticData.notifiedDiscussionIds = Array.from(notifiedIds);\n\nreturn newItems;"
      },
